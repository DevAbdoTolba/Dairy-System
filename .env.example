MONGODB_DB=dairy_system
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
DAIRY_GOOGLE_TOKEN_ENCRYPTION_KEY=
DAIRY_BACKUP_CRON_SECRET=
