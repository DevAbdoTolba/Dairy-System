# Use long random values in production; never commit the real .env file.
DAIRY_OWNER_PIN=change-this-to-a-private-pin
DAIRY_POS_PIN=change-this-to-a-private-pos-pin
DAIRY_SESSION_SECRET=replace-with-at-least-32-random-characters
